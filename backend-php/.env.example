# ============================================================
# Franchglobal Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to git.
# ============================================================


# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────

# Set to "production" on live server, "development" locally
APP_ENV=production

# Your backend root URL (no trailing slash)
APP_URL=https://franchglobal.com

# Your frontend URL — used for CORS and email links
FRONTEND_ORIGIN=https://franchglobal.com

# Public site URL used for product image paths in emails
# Usually the same as FRONTEND_ORIGIN
VITE_SITE_URL=https://franchglobal.com

# ─────────────────────────────────────────────────────────────
# MAINTENANCE MODE  (optional)
# ─────────────────────────────────────────────────────────────

# Set to "true" to put the site in maintenance mode
APP_MAINTENANCE=false

# Cookie name and secret used to bypass maintenance mode
MAINTENANCE_COOKIE_NAME=site_access
MAINTENANCE_COOKIE_SECRET=


# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# Get these from: Hostinger → Hosting → MySQL Databases

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# MySQL timezone offset — IST is +05:30
DB_TIMEZONE=+05:30


# ─────────────────────────────────────────────────────────────
# RAZORPAY
# ─────────────────────────────────────────────────────────────
# Get these from: Razorpay Dashboard → Settings → API Keys

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhooks → your webhook → Secret
# If left empty, falls back to RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# ─────────────────────────────────────────────────────────────
# DELHIVERY  ← fill these to enable shipping
# ─────────────────────────────────────────────────────────────
# How to get these:
#   1. Log in to https://app.delhivery.com
#   2. API Token    → Settings → API → copy the token
#   3. Client Code  → Settings → Account Details → Client Code
#   4. Pickup Location → Manage → Pickup Locations
#      Use the EXACT name you saved there (e.g. "Primary")

# Use https://track.delhivery.com for production
# Use https://staging-express.delhivery.com for testing
DELHIVERY_BASE_URL=https://track.delhivery.com

DELHIVERY_API_TOKEN=your_delhivery_api_token_here
DELHIVERY_CLIENT_CODE=your_client_code_here
DELHIVERY_PICKUP_LOCATION=Primary


# ─────────────────────────────────────────────────────────────
# EMAIL  (SMTP)
# ─────────────────────────────────────────────────────────────
# Used for order confirmation, shipped, delivered emails.
# Get these from: Hostinger → Emails → Manage → SMTP Settings
# (or any SMTP provider — Gmail, Brevo, Mailgun, etc.)

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_ENCRYPTION=tls
EMAIL_USER=contact@franchglobal.com
EMAIL_PASSWORD=your_email_password

# Name shown in the From field of customer emails
EMAIL_FROM_NAME=Franch Global

# Override the site URL used in email links (optional)
# Leave empty to use FRONTEND_ORIGIN
EMAIL_SITE_URL=


# ─────────────────────────────────────────────────────────────
# META / FACEBOOK  (Conversions API)
# ─────────────────────────────────────────────────────────────
# Get these from:
#   Pixel ID      → Meta Events Manager → your pixel → Settings
#   Access Token  → Meta Business Manager → System Users → Generate Token
#                   (grant: ads_management + pixel permissions)

META_PIXEL_ID=your_pixel_id_here
META_ACCESS_TOKEN=your_meta_system_user_token_here

# Optional: paste the test event code from Meta Events Manager
# while testing. Remove / leave empty in production.
META_TEST_EVENT_CODE=


# ─────────────────────────────────────────────────────────────
# GOOGLE  (Sign-In)
# ─────────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Only needed if Google Sign-In is enabled on the frontend

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com


# ─────────────────────────────────────────────────────────────
# TELEGRAM  (order alert notifications — optional)
# ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather, add it to your group,
# then get the group chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=


# ─────────────────────────────────────────────────────────────
# ORDER TRACKING  (optional cutoff date)
# ─────────────────────────────────────────────────────────────
# Orders placed BEFORE this date will not show the live tracking
# card or receive status-change emails.
# Leave empty to enable tracking for ALL paid orders.
# Format: YYYY-MM-DD HH:MM:SS  (server time, IST recommended)

TRACKING_FEATURE_START_AT=


# ─────────────────────────────────────────────────────────────
# SHIPROCKET  (legacy — no longer used by the Ship button)
# ─────────────────────────────────────────────────────────────
# The admin Ship button now uses Delhivery only.
# These keys are kept here in case the Shiprocket endpoint
# is called directly, but they are not required.

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
